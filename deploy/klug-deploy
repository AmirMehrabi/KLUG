#!/usr/bin/env bash
set -Eeuo pipefail

SHA="${1:-}"
BRANCH="${2:-master}"
[[ "$SHA" =~ ^[0-9a-f]{40}$ ]] || { echo "Expected a full commit SHA" >&2; exit 2; }
[[ "$BRANCH" == "main" || "$BRANCH" == "master" ]] || { echo "Unsupported branch" >&2; exit 2; }

BASE=/var/www/klug
RELEASES="$BASE/releases"
RELEASE="$RELEASES/$SHA"
WORK="$(mktemp -d "$BASE/.build-$SHA.XXXXXX")"
STAGED_RELEASE="$WORK/release"
LOCK="$BASE/shared/.deploy.lock"
exec 9>"$LOCK"
flock 9
trap 'rm -rf "$WORK"' EXIT

mkdir -p "$RELEASES"
ACTIVE_RELEASE="$(readlink -f "$BASE/current" 2>/dev/null || true)"
if [[ "$ACTIVE_RELEASE" == "$RELEASE" ]]; then
    echo "Release $SHA already exists; skipping"
    exit 0
fi
rm -rf "$RELEASE"

git clone --quiet --depth=1 --branch "$BRANCH" https://github.com/AmirMehrabi/KLUG.git "$WORK/repo"
HEAD_SHA="$(git -C "$WORK/repo" rev-parse HEAD)"
if [[ "$HEAD_SHA" != "$SHA" ]]; then
    echo "Ignoring stale webhook for $SHA; $BRANCH is now $HEAD_SHA"
    exit 0
fi
git -C "$WORK/repo" checkout --quiet --detach "$SHA"
mkdir "$STAGED_RELEASE"
git -C "$WORK/repo" archive "$SHA" | tar -x -C "$STAGED_RELEASE"

ln -s /var/www/klug/shared/.env "$STAGED_RELEASE/.env"
rm -rf "$STAGED_RELEASE/storage"
ln -s /var/www/klug/shared/storage "$STAGED_RELEASE/storage"
mkdir -p "$STAGED_RELEASE/bootstrap/cache"

cd "$STAGED_RELEASE"
composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader
npm ci --no-audit --no-fund
npm run build
rm -rf node_modules

php artisan migrate --force
php artisan config:cache
php artisan route:cache
php artisan view:cache

if [[ ! -e "$STAGED_RELEASE/public/storage" ]]; then
    ln -s /var/www/klug/shared/storage/app/public "$STAGED_RELEASE/public/storage"
fi

chown -R ammir:www-data "$STAGED_RELEASE"
find "$STAGED_RELEASE" -type d -exec chmod 755 {} +
find "$STAGED_RELEASE" -type f -exec chmod 644 {} +
chmod 755 "$STAGED_RELEASE/artisan"
chmod -R 775 "$STAGED_RELEASE/bootstrap/cache"

mv "$STAGED_RELEASE" "$RELEASE"

PREVIOUS=""
if [[ -L "$BASE/current" ]]; then
    PREVIOUS="$(readlink -f "$BASE/current")"
fi
ln -s "$RELEASE" "$BASE/current.next"
mv -Tf "$BASE/current.next" "$BASE/current"

if ! curl --fail --silent --show-error --max-time 20 --resolve klug.ir:443:127.0.0.1 --insecure https://klug.ir/ >/dev/null; then
    echo "Health check failed after switching to $SHA" >&2
    if [[ -n "$PREVIOUS" ]]; then
        ln -s "$PREVIOUS" "$BASE/current.rollback"
        mv -Tf "$BASE/current.rollback" "$BASE/current"
    else
        rm -f "$BASE/current"
    fi
    exit 1
fi

echo "Activated release $SHA"
install -m 755 "$RELEASE/deploy/klug-deploy" "$BASE/shared/klug-deploy.next"
mv -Tf "$BASE/shared/klug-deploy.next" "$BASE/shared/klug-deploy"
find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' \
    | sort -nr | tail -n +6 | cut -d' ' -f2- | xargs -r rm -rf
