[Unit]
Description=KLUG GitHub webhook receiver
After=network.target

[Service]
Type=simple
User=ammir
Group=www-data
EnvironmentFile=/etc/klug-webhook.env
ExecStart=/usr/bin/python3 /var/www/klug/current/deploy/github_webhook.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/klug-deploy.log /var/www/klug

[Install]
WantedBy=multi-user.target
