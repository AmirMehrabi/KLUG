[Unit]
Description=KLUG GitHub webhook receiver
After=network.target

[Service]
Type=simple
User=ammir
Group=www-data
EnvironmentFile=/etc/klug-webhook.env
Environment=HOME=/var/www/klug/shared/home
Environment=COMPOSER_HOME=/var/www/klug/shared/composer
Environment=XDG_CACHE_HOME=/var/www/klug/shared/cache
Environment=npm_config_cache=/var/www/klug/shared/npm-cache
ExecStart=/usr/bin/python3 /var/www/klug/current/deploy/github_webhook.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/klug-deploy.log /var/www/klug

[Install]
WantedBy=multi-user.target
